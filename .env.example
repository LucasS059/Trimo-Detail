# ==========================================
# TRIMO DETAIL - VARIÁVEIS DE AMBIENTE (.env)
# ==========================================

# Conexão com o Banco de Dados PostgreSQL (Obrigatório)
# Local (Docker): postgres://trimo_admin:trimo_dev_2026@localhost:5433/trimo_detail
DATABASE_URL="postgres://trimo_admin:trimo_dev_2026@localhost:5433/trimo_detail"

# URL base da aplicação (Obrigatório em produção e para links públicos/webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Segurança de Sessão e Autenticação (Obrigatório)
# Gere chaves seguras aleatórias para produção (ex: openssl rand -base64 32)
AUTH_SECRET="sua_chave_secreta_jwt_admin_super_segura"
SESSAO_ADMIN_SECRET="sua_chave_secreta_jwt_admin_super_segura"
SESSAO_CLIENTE_SECRET="sua_chave_secreta_jwt_cliente_super_segura"

# Automação de Lembretes (Cron)
# Protege a rota /api/cron/lembretes contra chamadas não autorizadas
CRON_SECRET="chave_secreta_do_cron_job"

# Mercado Pago (Pagamentos Pix e Maquininha Point)
# Em produção, cada loja pode configurar suas próprias credenciais em Configurações,
# mas você pode definir credenciais padrão de fallback se desejar:
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# WhatsApp API (Opcional - Notificações automáticas de status e lembretes)
# Integração com Evolution API, Z-API, Baileys ou provedor HTTP de WhatsApp
# WhatsApp API (Z-API Oficial ou outro provedor)
# Se usar Z-API, basta preencher ZAPI_INSTANCE_ID e ZAPI_INSTANCE_TOKEN:
# WhatsApp API (Notificações automáticas de status e lembretes)
# 1. Evolution API (Recomendado - Local via Docker ou Cloud)
EVOLUTION_API_URL="http://localhost:8082"
EVOLUTION_API_KEY="sua_chave_secreta_evolution_api"
EVOLUTION_INSTANCE_NAME="trimo"
EVOLUTION_DATABASE_URL="postgresql://usuario:senha@host:5432/TrimoDetail?sslmode=require&schema=evolution"

# 2. Provedores Alternativos (Z-API / HTTP Webhook)
ZAPI_INSTANCE_ID=""
ZAPI_INSTANCE_TOKEN=""
ZAPI_CLIENT_TOKEN=""
# Ou se preferir usar a URL direta de envio:
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# Vercel Blob Storage (Upload de logomarca e fotos dos serviços)
BLOB_READ_WRITE_TOKEN=""

# Notificações E-mail / SMS (Opcionais)
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASS=""
EMAIL_FROM=""
SMS_API_URL=""
SMS_API_TOKEN=""
